# Laravel Standard Ignored Files
/node_modules
/public/hot
/public/storage
/storage/*.key
/vendor
/.idea
/.vscode
/.fleet
/.zed
/.vagrant
Homestead.json
Homestead.yaml
npm-debug.log
yarn-error.log
.phpunit.result.cache
/.phpunit.cache
/build
.DS_Store
Thumbs.db
composer.phar
*.log
*.tmp
*.bak

# Environment & Credentials (CRITICAL - DO NOT COMMIT)
.env
.env.backup
.env.bak
.env.production
.env.local
.env.testing

# Storage Framework & Logs
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitkeep
/storage/framework/views/*
!/storage/framework/views/.gitkeep
/storage/framework/sessions/*
!/storage/framework/sessions/.gitkeep
/storage/framework/testing/*
!/storage/framework/testing/.gitkeep
/storage/logs/*
!/storage/logs/.gitkeep
/storage/app/public/*
!/storage/app/public/.gitkeep

# Bootstrap Cache
/bootstrap/cache/*.php
!/bootstrap/cache/.gitkeep

# User Uploaded Sensitive Files & Proof of Payments
/public/uploads/bukti_upah/*
!/public/uploads/bukti_upah/.gitkeep
